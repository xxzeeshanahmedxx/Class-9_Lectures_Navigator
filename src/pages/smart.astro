---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://class9hub.com';
const canonical = siteUrl + '/smart/';

const breadcrumbs = [
  { name: 'Home', url: siteUrl + '/' },
  { name: 'Smart Syllabus', url: canonical },
];

const subjects = [
  {
    name: 'Physics',
    emoji: '⚛️',
    href: '/smart/class-9-smart-syllabus-physics.pdf',
    pages: 8,
    size: '2.1 MB',
  },
  {
    name: 'Chemistry',
    emoji: '🧪',
    href: '/smart/class-9-smart-syllabus-chemistry.pdf',
    pages: 8,
    size: '1.8 MB',
  },
  {
    name: 'Mathematics',
    emoji: '➗',
    href: '/smart/class-9-smart-syllabus-math.pdf',
    pages: 11,
    size: '2.2 MB',
  },
  {
    name: 'Biology',
    emoji: '🧬',
    href: '/smart/class-9-smart-syllabus-biology.pdf',
    pages: 9,
    size: '1.6 MB',
  },
  {
    name: 'Urdu',
    emoji: '📖',
    href: '/smart/class-9-smart-syllabus-urdu.pdf',
    pages: 9,
    size: '1.6 MB',
  },
  {
    name: 'English',
    emoji: '🔤',
    href: '/smart/class-9-smart-syllabus-english.pdf',
    pages: 7,
    size: '1.6 MB',
  },
  {
    name: 'Islamiat',
    emoji: '☪️',
    href: '/smart/class-9-smart-syllabus-islamiat.pdf',
    pages: 5,
    size: '1.2 MB',
  },
];

const extras = [
  {
    title: 'Deleted Content — All Subjects',
    desc: 'Every subject combined in one file, for a quick overall look at what has been removed.',
    href: '/smart/class-9-smart-syllabus-deleted-content.pdf',
    pages: 13,
    size: '3.0 MB',
    tag: 'Combined',
  },
  {
    title: 'Model Papers & Pairing Scheme',
    desc: 'Paper pattern, pairing scheme and model papers per subject for the BISEs Annual Examination 2027.',
    href: '/smart/class-9-model-papers-pairing-scheme.pdf',
    pages: 44,
    size: '8.7 MB',
    tag: 'Exam practice',
  },
  {
    title: 'Full Smart Syllabus 2026-27',
    desc: 'The complete official notification: deleted topics, exercise questions, pairing schemes and model papers.',
    href: '/smart/class-9-smart-syllabus-2026-27-full.pdf',
    pages: 58,
    size: '13 MB',
    tag: 'Complete',
  },
];
---

<Layout
  title="Class 9 Smart Syllabus 2026-27 – Deleted Topics by Subject"
  heading="Smart Syllabus"
  headerHeading={false}
  backUrl="/"
  desc="Download the official Class 9 Smart Syllabus (ALP) 2026-27 for Punjab Board — subject-wise deleted topics and exercise questions, plus model papers and pairing schemes as free PDFs."
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@type': 'LearningResource',
    name: 'Class 9 Smart Syllabus 2026-27 (ALP) — Punjab Board',
    description:
      'Official PECTAA Smart Syllabus for Grade 9: subject-wise deleted topics and exercise questions, pairing schemes and model papers for the BISEs Annual Examination 2027.',
    learningResourceType: 'Syllabus',
    educationalLevel: 'Grade 9',
    inLanguage: ['en', 'ur'],
    isAccessibleForFree: true,
    provider: {
      '@type': 'EducationalOrganization',
      name: 'Class 9 Hub',
      url: siteUrl + '/',
    },
  }}
>
  <section>
    <h1 class="text-[22px] sm:text-[26px] font-bold mb-1 leading-tight" style="color: var(--text);">
      Class 9 Smart Syllabus 2026-27 📘
    </h1>
    <p class="text-[14px] sm:text-[15px] mb-4 leading-relaxed" style="color: var(--text-secondary);">
      Official notification from PECTAA, Government of the Punjab, for the
      Accelerated Learning Programme (ALP). Pick your subject below to see exactly which
      topics and exercise questions are removed for the academic session 2026-27 and
      BISEs Annual Examination 2027.
    </p>

    <div
      class="rounded-xl border px-4 py-3 mb-6 text-[13px] sm:text-[14px] leading-relaxed"
      style="background: var(--card-bg); border-color: var(--card-border); color: #d7d7e6;"
    >
      <span class="font-semibold" style="color: #fff;">Note:</span>
      All questions in the BISE exam papers will come from the <em>entire textbook</em>
      except the topics and exercise questions marked as deleted in the Smart Syllabus.
    </div>

    <h2 class="text-[16px] sm:text-[18px] font-semibold mb-3" style="color: var(--text);">
      Deleted topics by subject
    </h2>

    <div class="grid gap-3 sm:grid-cols-2">
      {subjects.map((s) => (
        <a
          href={s.href}
          download
          class="group flex items-start gap-3 px-4 py-3.5 rounded-xl border active:scale-[0.99] hover:[background:var(--card-hover)] transition"
          style="background: var(--card-bg); border-color: var(--card-border);"
        >
          <span
            class="flex items-center justify-center w-9 h-9 rounded-lg text-[16px] flex-shrink-0"
            style="background: #1a1a28; border: 1px solid #2a2a3e;"
            aria-hidden="true"
          >
            {s.emoji}
          </span>
          <div class="min-w-0 flex-1">
            <div class="text-[15px] sm:text-[16px] font-semibold" style="color: #e8e8f0;">
              {s.name}
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px]" style="color: #6b6b85;">
              <span>{s.pages} pages</span>
              <span aria-hidden="true">·</span>
              <span>{s.size}</span>
              <span aria-hidden="true">·</span>
              <span class="font-medium" style="color: var(--accent);">Download PDF</span>
            </div>
          </div>
          <span class="text-base self-center" style="color: #6b6b85;" aria-hidden="true">&darr;</span>
        </a>
      ))}
    </div>

    <h2 class="text-[16px] sm:text-[18px] font-semibold mt-7 mb-3" style="color: var(--text);">
      Also useful
    </h2>

    <div class="grid gap-4">
      {extras.map((f) => (
        <a
          href={f.href}
          download
          class="group flex items-start gap-4 px-4 py-4 rounded-xl border active:scale-[0.99] hover:[background:var(--card-hover)] transition"
          style="background: var(--card-bg); border-color: var(--card-border);"
        >
          <span
            class="flex items-center justify-center w-10 h-10 rounded-lg text-[11px] font-bold flex-shrink-0 gradient-brand text-white"
            aria-hidden="true"
          >
            PDF
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <div class="text-[16px] sm:text-[17px] font-semibold" style="color: #e8e8f0;">
                {f.title}
              </div>
              <span
                class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-full"
                style="background: #1a1a28; color: #9e9eb8; border: 1px solid #2a2a3e;"
              >
                {f.tag}
              </span>
            </div>
            <p class="mt-1 text-[13px] sm:text-[14px] leading-relaxed" style="color: #9e9eb8;">
              {f.desc}
            </p>
            <div class="mt-2 flex items-center gap-3 text-[12px]" style="color: #6b6b85;">
              <span>{f.pages} pages</span>
              <span aria-hidden="true">·</span>
              <span>{f.size}</span>
              <span aria-hidden="true">·</span>
              <span class="font-medium" style="color: var(--accent);">Download PDF</span>
            </div>
          </div>
          <span class="text-base self-center" style="color: #6b6b85;" aria-hidden="true">&darr;</span>
        </a>
      ))}
    </div>

    <div
      class="mt-6 rounded-xl border px-4 py-4 text-[13px] leading-relaxed"
      style="background: var(--card-bg); border-color: var(--card-border); color: #9e9eb8;"
    >
      <p class="mb-2 font-semibold" style="color: #e8e8f0;">What's inside each subject PDF</p>
      <ul class="list-disc pl-5 space-y-1">
        <li>Deleted topics for that subject, chapter by chapter</li>
        <li>Deleted exercise questions and short/long question lists</li>
        <li>Clear tables matching the official PECTAA notification</li>
      </ul>
      <p class="mt-3">
        Source: Punjab Education, Curriculum, Training and Assessment Authority (PECTAA),
        Government of the Punjab.
      </p>
    </div>
  </section>
</Layout>
