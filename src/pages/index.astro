---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import subjects from '../data/subjects.json';
const siteUrl = 'https://class9hub.com';
---

<Layout
  title="Free Class 9 Lectures – Punjab Board 2026"
  desc="Free class 9 lectures for Punjab Board 2026. Watch physics class 9, math, chemistry, computer and urdu video lectures online. Full chapter-wise course."
  canonical={siteUrl}
  noHeader={true}
>
  <div class="text-center mb-6 sm:mb-8 pt-4 animate-fade-in-up">
    <h1 class="text-[22px] sm:text-[28px] font-bold leading-tight">Free Class 9 Lectures – Punjab Board</h1>
    <p class="mt-1.5 text-[14px] sm:text-[15px]" style="color: var(--text-secondary);">Physics, Math, Chemistry, Urdu &amp; Computer · Full Course 2026</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    {subjects.map((s, i) => (
      <div class={`animate-fade-in-up animate-delay-${i + 1}`}>
        <SubjectCard id={s.id} title={s.title} emoji={s.emoji} accent={s.accent} />
      </div>
    ))}
  </div>

  <a
    href="/smart/"
    class="mt-4 sm:mt-5 flex items-center gap-4 px-4 py-4 rounded-xl border active:scale-[0.99] hover:[background:var(--card-hover)] animate-fade-in-up"
    style="background: var(--card-bg); border-color: var(--card-border);"
  >
    <span
      class="flex items-center justify-center w-10 h-10 rounded-lg text-[11px] font-bold flex-shrink-0 gradient-brand text-white"
      aria-hidden="true"
    >
      PDF
    </span>
    <div class="min-w-0 flex-1">
      <div class="text-[16px] sm:text-[17px] font-semibold" style="color: #e8e8f0;">
        Smart Syllabus 2026-27
      </div>
      <span class="text-[13px]" style="color: #9e9eb8;">
        Deleted topics, model papers &amp; pairing schemes
      </span>
    </div>
    <span class="text-base" style="color: #6b6b85;" aria-hidden="true">&rarr;</span>
  </a>

</Layout>
