---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import ThemeStyles from '../components/ThemeStyles.astro';

export interface Props {
  title: string;
  subtitle?: string;
  desc?: string;
  colors?: {
    accent: string; accent2: string; bg: string; bg2: string; bg3: string;
    card: string; card2: string; line: string; soft: string;
  } | null;
  backUrl?: string;
  canonical?: string;
  showPWA?: boolean;
  noHeader?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  /** Keep this page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Absolute or root-relative social share image. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra schema.org nodes merged into this page's JSON-LD graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  currentSubject?: string;
}

const {
  title, subtitle, colors, backUrl, canonical, showPWA, noHeader,
  breadcrumbs, currentSubject, noindex, ogImage, ogType = 'website', jsonLd,
} = Astro.props;

const accentColor = colors?.accent || '#8cb4ff';
const siteName = 'Class 9 \u00b7 Punjab Curriculum';
const siteUrl = 'https://class9hub.com';
const defaultDesc = 'Free study lectures for 9th grade Punjab board students \u2014 Mathematics, Physics, Chemistry, Computer, Urdu.';
const desc = Astro.props.desc || defaultDesc;
const pageTitle = title === siteName ? title : `${title} \u00b7 ${siteName}`;

// Canonical URLs always carry a trailing slash so they match the sitemap exactly.
let canonicalUrl = canonical || Astro.url.href;
if (!canonicalUrl.endsWith('/')) canonicalUrl += '/';

const shareImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage)
  : siteUrl + '/og-image.png';
const shareImageAlt = 'Class 9 Hub \u2014 free Punjab Board video lectures for Physics, Math, Chemistry, Urdu and Computer';

const orgId = siteUrl + '/#organization';
const websiteId = siteUrl + '/#website';

const graph: Record<string, unknown>[] = [
  {
    '@type': 'EducationalOrganization',
    '@id': orgId,
    name: 'Class 9 Hub',
    url: siteUrl + '/',
    logo: {
      '@type': 'ImageObject',
      url: siteUrl + '/web-app-manifest-512x512.png',
      width: 512,
      height: 512,
    },
    founder: { '@type': 'Person', name: 'Zeeshan Ahmed' },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: siteName,
    url: siteUrl + '/',
    description: defaultDesc,
    inLanguage: 'en',
    publisher: { '@id': orgId },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: siteUrl + '/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'WebPage',
    '@id': canonicalUrl + '#webpage',
    url: canonicalUrl,
    name: pageTitle,
    description: desc,
    isPartOf: { '@id': websiteId },
    about: { '@id': orgId },
    inLanguage: 'en',
    primaryImageOfPage: { '@type': 'ImageObject', url: shareImage },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': canonicalUrl + '#breadcrumb',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.url.startsWith('http') ? b.url : siteUrl + b.url,
    })),
  });
}

if (jsonLd) {
  graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="9wMIiVm55vRQLteCGqw9691RYnVIVzSzlrZRvj8tupQ" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="Zeeshan Ahmed" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content="Class 9 Hub" />
    <meta name="theme-color" content="#f8f9fc" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Warm up the video CDNs used by the player overlay -->
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    ></script>

    <ThemeStyles colors={colors} />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }

      // PWA install prompt
      let deferredPrompt = null;
      const banner = document.getElementById('pwa-banner');
      const installBtn = document.getElementById('pwa-install');
      const dismissBtn = document.getElementById('pwa-dismiss');

      // Hide banner initially
      if (banner) banner.style.display = 'none';

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (banner && !localStorage.getItem('pwa-dismissed')) {
          banner.style.display = 'block';
          requestAnimationFrame(() => banner.classList.remove('translate-y-full'));
        }
      });

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          const result = await deferredPrompt.userChoice;
          deferredPrompt = null;
          if (banner) {
            banner.classList.add('translate-y-full');
            setTimeout(() => { banner.style.display = 'none'; }, 300);
          }
        });
      }

      if (dismissBtn) {
        dismissBtn.addEventListener('click', () => {
          if (banner) {
            banner.classList.add('translate-y-full');
            setTimeout(() => { banner.style.display = 'none'; }, 300);
          }
          localStorage.setItem('pwa-dismissed', '1');
        });
      }

      // Check if already installed (display-mode: standalone)
      if (window.matchMedia('(display-mode: standalone)').matches) {
        if (banner) banner.style.display = 'none';
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col" style="background: var(--page);">
    {!noHeader && (
    <header class="sticky top-0 z-40 animate-fade-in" style="background: #0d0d14; border-bottom: 1px solid var(--card-border); backdrop-filter: blur(12px);">
      <div class="flex items-center gap-3 px-4 h-[70px] sm:h-20 max-w-4xl mx-auto">
        {backUrl ? (
          <a href={backUrl} class="flex items-center justify-center w-10 h-10 -ml-1 rounded-xl active:opacity-50 flex-shrink-0" style="color: #6b6b85;" aria-label="Back">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          </a>
        ) : (
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <span class="text-[24px] sm:text-[26px] font-bold leading-none gradient-brand" style="-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">9</span>
          </div>
        )}
        <div class="min-w-0 flex-1">
          <h1 class="text-[18px] sm:text-[20px] font-semibold truncate leading-tight" style="color: #e8e8f0;">{title}</h1>
          {subtitle && <p class="text-[13px] sm:text-[14px] leading-tight truncate" style="color: #9e9eb8;">{subtitle}</p>}
        </div>
      </div>
    </header>
    )}
    <main class="flex-1 max-w-4xl mx-auto w-full px-3 sm:px-4 py-4 sm:py-6 animate-fade-in-up">
      <slot />
    </main>
    <div class="max-w-4xl mx-auto px-3 sm:px-4 mb-2">
      <div class="border-t pt-4 pb-2 text-center" style="border-color: var(--hairline);">
        {currentSubject === 'physics' ? (
          <p class="text-[13px] leading-relaxed" style="color: var(--text-secondary);">
            📘 Also explore <a href="/math/" class="font-medium underline underline-offset-2 hover:opacity-80" style="color: var(--accent);">Math Class 9</a> – free Punjab Board video lectures →
          </p>
        ) : (
          <p class="text-[13px] leading-relaxed" style="color: var(--text-secondary);">
            📘 Also explore <a href="/physics/" class="font-medium underline underline-offset-2 hover:opacity-80" style="color: var(--accent);">Physics Class 9</a> – free Punjab Board video lectures →
          </p>
        )}
      </div>
    </div>
    {showPWA && (
    <div id="pwa-banner" class="fixed bottom-0 left-0 right-0 z-30 translate-y-full transition-transform duration-300" style="background: var(--surface); border-top: 1px solid var(--hairline);">
      <div class="flex items-center gap-3 px-4 py-3 max-w-4xl mx-auto">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 gradient-brand text-white text-[13px] font-bold">9</div>
        <div class="min-w-0 flex-1">
          <div class="text-[13px] font-medium" style="color: var(--text);">Install App</div>
          <div class="text-[11px]" style="color: var(--text-secondary);">Open lectures faster from your home screen</div>
        </div>
        <button id="pwa-install" class="px-4 h-8 rounded-lg text-[12px] font-medium flex-shrink-0 gradient-brand text-white active:scale-95">Install</button>
        <button id="pwa-dismiss" class="w-7 h-7 flex items-center justify-center flex-shrink-0 active:opacity-50" style="color: var(--text-muted);" aria-label="Dismiss">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    )}
    <script is:inline>
      (function() {
        const banner = document.getElementById('pwa-banner');
        if (!banner) return;
        const installBtn = document.getElementById('pwa-install');
        const dismissBtn = document.getElementById('pwa-dismiss');
        if (window.matchMedia('(display-mode: standalone)').matches) return;
        if (localStorage.getItem('pwa-dismissed')) return;

        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          banner.classList.remove('translate-y-full');
        });

        installBtn.addEventListener('click', async () => {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          const result = await deferredPrompt.userChoice;
          deferredPrompt = null;
          if (result.outcome === 'accepted') banner.classList.add('translate-y-full');
        });

        dismissBtn.addEventListener('click', () => {
          localStorage.setItem('pwa-dismissed', '1');
          banner.classList.add('translate-y-full');
        });
      })();
    </script>

    <footer class={`text-center text-[11px] leading-relaxed py-4 px-4 space-y-0.5${showPWA ? ' pb-20' : ''}`} style="color: var(--text-secondary);">
      <p>Lectures belong to their respective teachers.</p>
      <p>Made by Zeeshan Ahmed · <a href="https://class9hub.com" class="underline underline-offset-2 hover:opacity-80" style="color: var(--text-secondary);">Class 9 Hub</a></p>
    </footer>
    <script>
      import PlayerOverlay from '../components/PlayerOverlay.js';

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.video-trigger');
        if (btn) {
          const videoId = btn.dataset.videoId;
          if (videoId) {
            e.preventDefault();
            const player = new PlayerOverlay();
            player.open(videoId);
          }
        }
      });
    </script>
  </body>
</html>
