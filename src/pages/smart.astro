---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://class9hub.com';
const canonical = siteUrl + '/smart/';

const breadcrumbs = [
  { name: 'Home', url: siteUrl + '/' },
  { name: 'Smart Syllabus', url: canonical },
];

const files = [
  {
    title: 'Deleted Content — All Subjects',
    desc: 'Every subject combined in one file, for a quick overall look at what has been removed.',
    href: '/smart/smart-deleted.pdf',
    pages: 13,
    size: '3.0 MB',
    tag: 'Short version',
  },
  {
    title: 'Model Papers & Pairing Scheme',
    desc: 'Paper pattern, pairing scheme and model papers per subject for the BISEs Annual Examination 2027.',
    href: '/smart/smart-teachers.pdf',
    pages: 44,
    size: '8.7 MB',
    tag: 'Exam practice',
  },
  {
    title: 'Full Smart Syllabus 2026-27',
    desc: 'The complete official notification: deleted topics, exercise questions, pairing schemes and model papers.',
    href: '/smart/smart.pdf',
    pages: 58,
    size: '13 MB',
    tag: 'Complete',
  },
];

const subjects = [
  {
    name: 'Physics',
    emoji: '⚛️',
    href: '/smart/smart-physics.pdf',
    pages: 8,
    size: '2.1 MB',
  },
  {
    name: 'Chemistry',
    emoji: '🧪',
    href: '/smart/smart-chemistry.pdf',
    pages: 8,
    size: '1.8 MB',
  },
  {
    name: 'Mathematics',
    emoji: '➗',
    href: '/smart/smart-math.pdf',
    pages: 11,
    size: '2.2 MB',
  },
  {
    name: 'Biology',
    emoji: '🧬',
    href: '/smart/smart-bio.pdf',
    pages: 9,
    size: '1.6 MB',
  },
  {
    name: 'Urdu',
    emoji: '📖',
    href: '/smart/smart-urdu.pdf',
    pages: 9,
    size: '1.6 MB',
  },
  {
    name: 'English',
    emoji: '🔤',
    href: '/smart/smart-english.pdf',
    pages: 7,
    size: '1.6 MB',
  },
  {
    name: 'Islamiat',
    emoji: '☪️',
    href: '/smart/smart-islamiat.pdf',
    pages: 5,
    size: '1.2 MB',
  },
];
---

<Layout
  title="Class 9 Smart Syllabus 2026-27 – Deleted Topics by Subject"
  heading="Smart Syllabus"
  headerHeading={false}
  backUrl="/"
  desc="Download the official Class 9 Smart Syllabus (ALP) 2026-27 for Punjab Board — deleted topics and exercise questions, plus model papers and pairing schemes as free PDFs."
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@type': 'LearningResource',
    name: 'Class 9 Smart Syllabus 2026-27 (ALP) — Punjab Board',
    description:
      'Official PECTAA Smart Syllabus for Grade 9: deleted topics and exercise questions, pairing schemes and model papers for the BISEs Annual Examination 2027.',
    learningResourceType: 'Syllabus',
    educationalLevel: 'Grade 9',
    inLanguage: ['en', 'ur'],
    isAccessibleForFree: true,
    provider: {
      '@type': 'EducationalOrganization',
      name: 'Class 9 Hub',
      url: siteUrl + '/',
    },
  }}
>
  <section>
    <h1 class="text-[22px] sm:text-[26px] font-bold mb-4 leading-tight" style="color: var(--text);">
      Class 9 Smart Syllabus 2026-27 📘
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {files.map((f) => (
        <a
          href={f.href}
          download
          title={f.desc}
          class="group flex flex-col justify-between p-3.5 rounded-xl border active:scale-[0.98] hover:[background:var(--card-hover)] transition"
          style="background: var(--card-bg); border-color: var(--card-border);"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span
                class="flex items-center justify-center w-8 h-8 rounded-lg text-[10px] font-bold gradient-brand text-white"
                aria-hidden="true"
              >
                PDF
              </span>
              <span
                class="text-[9px] uppercase tracking-wide px-1.5 py-0.5 rounded-full"
                style="background: #1a1a28; color: #9e9eb8; border: 1px solid #2a2a3e;"
              >
                {f.tag}
              </span>
            </div>
            <div class="text-[14px] font-semibold leading-snug" style="color: #e8e8f0;">
              {f.title}
            </div>
          </div>
          <div class="mt-3 text-[11px] leading-relaxed" style="color: #6b6b85;">
            {f.pages} pages · {f.size}
            <span class="font-medium" style="color: var(--accent);">· Download</span>
          </div>
        </a>
      ))}
    </div>

    <h2 class="text-[16px] sm:text-[18px] font-semibold mt-7 mb-3" style="color: var(--text);">
      By subject
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      {subjects.map((s) => (
        <a
          href={s.href}
          download
          class="group flex flex-col justify-between p-3.5 rounded-xl border active:scale-[0.98] hover:[background:var(--card-hover)] transition"
          style="background: var(--card-bg); border-color: var(--card-border);"
        >
          <div class="flex items-center gap-2">
            <span
              class="flex items-center justify-center w-8 h-8 rounded-lg text-[15px] flex-shrink-0"
              style="background: #1a1a28; border: 1px solid #2a2a3e;"
              aria-hidden="true"
            >
              {s.emoji}
            </span>
            <div class="text-[14px] font-semibold leading-snug" style="color: #e8e8f0;">
              {s.name}
            </div>
          </div>
          <div class="mt-3 text-[11px] leading-relaxed" style="color: #6b6b85;">
            {s.pages} pages · {s.size}
            <span class="font-medium" style="color: var(--accent);">· Download</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
